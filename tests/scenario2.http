#=================================================================================
# Sanity check
#=================================================================================

###

# Call APIM status endpoint via the Application Gateway to verify connectivity
# and that the Application Gateway is routing requests correctly.

GET https://{{agwIPAddress}}/status-0123456789abcdef
Host: agw.mtls-sample.dev


#=================================================================================
# Requests to call the Protected API via the Application Gateway on mTLS endpoint
#=================================================================================

###

# Calls the validate-from-agw operation. This operation will fail in no client certificate or an invalid client certificate is presented,
# and will succeed if a valid client certificate is presented.
# This demonstrates that mTLS is working as expected when calling the Protected API via the Application Gateway.

GET https://{{agwIPAddress}}:{{mtlsPort}}/protected/validate-from-agw
Host: agw.mtls-sample.dev


###

# Calls the validate-using-policy operation where the client certificate is validated using the validate-client-certificate policy.
# This request should fail because the Application Gateway terminates the mTLS connection
# and forwards the request to APIM over regular HTTPS, so APIM does not receive the client certificate.

GET https://{{agwIPAddress}}:{{mtlsPort}}/protected/validate-using-policy
Host: agw.mtls-sample.dev


###

# Calls the validate-using-context operation where the client certificate is validated using the `context.Request.Certificate` property.
# This request should fail because the Application Gateway terminates the mTLS connection
# and forwards the request to APIM over regular HTTPS, so APIM does not receive the client certificate.

GET https://{{agwIPAddress}}:{{mtlsPort}}/protected/validate-using-context
Host: agw.mtls-sample.dev


#=================================================================================
# Requests to demonstrate possible security vulnerability
#=================================================================================

###

# Call validate-from-agw directly on API Management with the public part of a valid client certificate in the `X-Client-Certificate` header.
# This request succeeds, demonstrating the importance of network isolation and defense in depth where possible.

GET https://{{apimHostname}}/protected/validate-from-agw
X-Client-Certificate: {{validClientCertificate}}

###

# Call validate-from-agw via Application Gateway with the public part of a valid client certificate in the `X-Client-Certificate` header.
# This request should fail because the HTTPS listener on the Application Gateway is configured to remove the `X-Client-Certificate` header.


GET https://{{agwIPAddress}}:443/protected/validate-from-agw
Host: agw.mtls-sample.dev
X-Client-Certificate: {{validClientCertificate}}
