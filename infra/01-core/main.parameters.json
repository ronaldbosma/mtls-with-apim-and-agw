{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "includeApplicationGateway": {
      "value": "${INCLUDE_APPLICATION_GATEWAY}"
    },
    "applicationGatewayMtlsMode": {
      "value": "${AZURE_APPLICATION_GATEWAY_MTLS_MODE}"
    },
    "apiManagementSku": {
      "value": "${AZURE_API_MANAGEMENT_SKU}"
    },
    "validateCertificateChainInProtectedApi": {
      "value": "${VALIDATE_CERTIFICATE_CHAIN_IN_PROTECTED_API}"
    }
  }
}